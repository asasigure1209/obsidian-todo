{
  "name": "obsidian-todo",
  "version": "0.1.0",
  "description": "1日単位のカンバン型TODOボード（ポモドーロ付き）",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "check": "biome check .",
    "fix": "biome check --write .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "mutation": "stryker run",
    "verify": "pnpm check && pnpm typecheck && pnpm coverage && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "^24.19.2",
    "@types/sortablejs": "1.15.9",
    "@vitest/coverage-v8": "5.1.0",
    "esbuild": "0.28.2",
    "esbuild-svelte": "0.9.5",
    "fast-check": "4.10.2",
    "lefthook": "2.2.2",
    "obsidian": "1.14.4",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook"
    ]
  },
  "dependencies": {
    "sortablejs": "1.15.7"
  }
}
